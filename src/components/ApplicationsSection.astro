---
const filters = [
  { label: 'All', value: 'all' },
  { label: 'Real Estate', value: 'realestate' },
  { label: 'Hospitality', value: 'hospitality' },
  { label: 'Travel', value: 'travel' },
  { label: 'Lifestyle', value: 'lifestyle' },
  { label: 'Wellness', value: 'wellness' },
  { label: 'Investment', value: 'investment' },
];

const useCases = [
  {
    emoji: '🏖️',
    title: 'Luxury Real Estate &amp; Coastal Developments',
    body: 'Beachfront properties, villa rentals, or a premier portal for oceanfront living.',
    tags: 'realestate investment',
  },
  {
    emoji: '🏨',
    title: 'Hospitality &amp; Resorts',
    body: 'A flagship name for a boutique hotel group, wellness retreat, or private villa collection.',
    tags: 'hospitality investment',
  },
  {
    emoji: '👗',
    title: 'Lifestyle &amp; Fashion',
    body: 'Premium beachwear, resort collections, home &amp; lifestyle products, or a full lifestyle brand.',
    tags: 'lifestyle',
  },
  {
    emoji: '✈️',
    title: 'Travel, Media &amp; Content',
    body: 'A leading platform for beach destinations, digital nomad coastal living, or high-end travel media.',
    tags: 'travel lifestyle',
  },
  {
    emoji: '🧘',
    title: 'Wellness &amp; Experiential',
    body: 'Yoga retreats, surf &amp; wellness programs, or luxury experiential travel.',
    tags: 'wellness travel hospitality',
  },
  {
    emoji: '💎',
    title: 'Investment / Holding Play',
    body: 'A scarce digital asset with strong brand equity and resale potential.',
    tags: 'investment',
  },
];
---

<section id="opportunity" class="py-20 sm:py-24 px-4 sm:px-6 scroll-mt-24">
  <div class="max-w-5xl mx-auto">
    <div class="accent-line mb-8 reveal"></div>
    <h2 class="section-title text-center mb-6 reveal">Endless High-Value Applications</h2>
    <p class="text-lg text-ocean-600 dark:text-ocean-300 text-center max-w-2xl mx-auto mb-10 reveal">
      This domain is a blank canvas for visionary brands and projects. Filter by the path that fits you.
    </p>

    <!-- Portfolio-style filter (instant, no backend) -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-12 reveal" role="group" aria-label="Filter opportunities by category">
      {filters.map((f, i) => (
        <button
          type="button"
          class={`chip usecase-filter ${i === 0 ? 'chip-active' : 'chip-idle'}`}
          data-filter={f.value}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f.label}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {useCases.map((u) => (
        <div class="glass rounded-2xl p-7 text-center usecase-card reveal" data-tags={u.tags}>
          <div class="text-3xl mb-4">{u.emoji}</div>
          <h3 class="font-serif text-lg font-semibold text-ocean-900 dark:text-white mb-3" set:html={u.title} />
          <p class="text-ocean-700 dark:text-ocean-300 text-sm leading-relaxed" set:html={u.body} />
        </div>
      ))}
    </div>

    <p id="filter-empty" class="hidden text-center text-ocean-600 dark:text-ocean-300 mt-8">
      No matching category &mdash; try &ldquo;All&rdquo;.
    </p>
  </div>
</section>
