---
const offerMailto =
  'mailto:sales@desertrich.com?subject=Offer%20for%20VidaEnLaPlaya.com%20%E2%80%94%20%5BYour%20Offer%5D&body=Hi%2C%0A%0AI%27d%20like%20to%20make%20an%20offer%20for%20VidaEnLaPlaya.com.%0A%0AOffer%20amount%20(USD)%3A%20%0AIntended%20use%3A%20%0AName%3A%20%0A';
const buyNowMailto =
  'mailto:sales@desertrich.com?subject=Buy%20Now%20%E2%80%94%20VidaEnLaPlaya.com%20via%20Escrow&body=Hi%2C%0A%0AI%27d%20like%20to%20proceed%20with%20a%20secure%20Escrow.com%20transaction%20for%20VidaEnLaPlaya.com.%20Please%20send%20next%20steps.%0A%0AName%3A%20%0A';
---

<section class="py-16 sm:py-20 px-4 sm:px-6 bg-ocean-800 dark:bg-abyss-900 text-white">
  <div class="max-w-3xl mx-auto text-center">
    <span class="inline-block px-4 py-1 bg-white/10 rounded-full text-xs font-medium tracking-[1.5px] text-white/80 mb-5">
      PREMIUM DOMAIN AVAILABLE
    </span>
    <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold mb-5 leading-tight reveal">
      Ready to Own Beach Life?
    </h2>
    <p class="text-lg text-ocean-200/90 leading-relaxed mb-8 max-w-xl mx-auto reveal">
      VidaEnLaPlaya.com is available for premium acquisition at $75,000 USD. Start a confidential conversation today.
    </p>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 reveal">
      <a href={offerMailto} data-track="final-make-offer" class="cta-accent px-8 py-4 text-base sm:text-lg">
        Submit Your Offer
      </a>
      <a href={buyNowMailto} data-track="final-buy-now" class="inline-flex items-center justify-center px-8 py-4 min-h-[48px] bg-white text-ocean-800 hover:bg-ocean-50 font-semibold rounded-xl transition-all text-base sm:text-lg">
        Buy Now via Escrow
      </a>
    </div>

    <p class="mt-6 text-xs text-white/75">
      Confidential &bull; No obligation &bull; Response within 24 hours &bull; Secure escrow transfer
    </p>
  </div>
</section>
