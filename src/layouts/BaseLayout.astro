---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  keywords?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'VidaEnLaPlaya.com for sale — premium .com that owns "Beach Life". Asking $75,000 USD, serious offers considered. Secure Escrow.com transfer. Inquire now — response within 24 hours.',
  image = 'https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/7ad296d3-6138-4c1f-272c-4a560d04ea00/public',
  keywords,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f0f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#040e13" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="light dark" />

    <title>{title}</title>
    <SEO title={title} description={description} pathname={Astro.url.pathname} image={image} keywords={keywords} noindex={noindex} />

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="6TnbteSqhJoNwmJU3ZcZZuL7M0RaiK0rcNVgO7x7vlg" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" type="application/xml" />

    <!-- Performance: early connections only (no render-blocking third-party JS) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://imagedelivery.net" crossorigin />
    <link rel="dns-prefetch" href="https://imagedelivery.net" />

    <!-- Google Fonts (non-blocking: media swap, no invisible text) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- Feature gate (before paint): reveal styles apply only when JS is available -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- Avoid dark-mode flash: runs before paint, <1KB -->
    <script is:inline>
      try {
        const t = localStorage.getItem('vida-theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {}
    </script>

    <!-- Cloudflare Web Analytics (free, privacy-first) — enable token in dashboard -->
    <!-- <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"REPLACE_WITH_TOKEN"}'></script> -->

    <slot name="head" />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      // Theme toggle (persisted, respects OS default)
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('vida-theme', dark ? 'dark' : 'light');
        } catch (e) {}
      });

      // Sticky nav shadow on scroll (passive = no scroll jank)
      const nav = document.getElementById('site-nav');
      const onScroll = () => {
        if (!nav) return;
        const on = window.scrollY > 16;
        nav.classList.toggle('shadow-md', on);
        nav.classList.toggle('backdrop-blur-xl', on);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Scroll-reveal (respects prefers-reduced-motion, disconnects when done)
      (() => {
        const all = document.querySelectorAll('.reveal');
        if (!all.length) return;
        if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          all.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );
        all.forEach((el) => io.observe(el));
      })();

      // Copy email (progressive enhancement, no dependency)
      document.getElementById('copyEmailBtn')?.addEventListener('click', () => {
        const email = 'sales@desertrich.com';
        const btn = document.getElementById('copyEmailBtn');
        const label = btn?.querySelector('span');
        const done = () => {
          if (!label) return;
          const original = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = original;
          }, 2200);
        };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(email).then(done).catch(() => {
            window.location.href = 'mailto:' + email;
          });
        } else {
          window.location.href = 'mailto:' + email;
        }
      });

      // CTA tracking (free: local log + sendBeacon hook for Cloudflare Web Analytics)
      document.querySelectorAll('[data-track]').forEach((el) => {
        el.addEventListener('click', () => {
          const name = el.getAttribute('data-track') || 'cta';
          try {
            const key = 'vida-events';
            const raw = localStorage.getItem(key);
            const arr = raw ? JSON.parse(raw) : [];
            arr.push({ e: name, t: Date.now() });
            localStorage.setItem(key, JSON.stringify(arr.slice(-100)));
          } catch (e) {}
          if (navigator.sendBeacon) {
            try {
              navigator.sendBeacon('/api/track', JSON.stringify({ event: name }));
            } catch (e) {}
          }
        });
      });

      // Mobile menu (accessible: aria-expanded, Esc to close, 48px targets)
      const menuBtn = document.getElementById('mobile-menu-btn');
      if (menuBtn) {
        let overlay = null;
        const close = () => {
          overlay?.remove();
          overlay = null;
          menuBtn.setAttribute('aria-expanded', 'false');
          menuBtn.setAttribute('aria-label', 'Open menu');
          document.body.style.overflow = '';
        };
        const links = [
          ['The Meaning', '/#meaning'],
          ['Why Premium', '/#why'],
          ['Opportunities', '/#opportunity'],
          ['Market Value', '/#value'],
          ['How to Acquire', '/#acquire'],
          ['FAQ', '/#faq'],
          ['Insights', '/insights/'],
        ];
        menuBtn.addEventListener('click', () => {
          if (overlay) {
            close();
            return;
          }
          menuBtn.setAttribute('aria-expanded', 'true');
          menuBtn.setAttribute('aria-label', 'Close menu');
          overlay = document.createElement('div');
          overlay.id = 'mobile-menu';
          overlay.className = 'fixed inset-0 bg-black/60 z-[100] lg:hidden';
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-label', 'Site menu');
          overlay.innerHTML = `
            <div class="bg-white dark:bg-abyss-900 w-72 max-w-[85vw] h-full p-6 shadow-2xl flex flex-col overflow-y-auto">
              <div class="flex justify-between items-center mb-6">
                <span class="font-serif text-xl font-semibold text-ocean-900 dark:text-white">VidaEnLaPlaya<span class="text-sand-500">.com</span></span>
                <button type="button" aria-label="Close menu" class="w-12 h-12 inline-flex items-center justify-center text-3xl text-ocean-400 hover:text-ocean-700 dark:hover:text-white">&times;</button>
              </div>
              <div class="flex flex-col text-base font-medium">
                ${links
                  .map(
                    ([label, href]) =>
                      `<a href="${href}" class="py-3 px-1 min-h-[48px] inline-flex items-center text-ocean-800 dark:text-ocean-100 border-b border-ocean-100 dark:border-ocean-800">${label}</a>`
                  )
                  .join('')}
              </div>
              <div class="mt-auto pt-6 space-y-3">
                <a href="/#offer" class="cta-primary w-full px-5 py-3 text-sm">Make an Offer</a>
                <a href="mailto:sales@desertrich.com?subject=Acquisition%20Inquiry%20-%20VidaEnLaPlaya.com" class="cta-secondary w-full px-5 py-3 text-sm">Email sales@desertrich.com</a>
              </div>
            </div>`;
          document.body.appendChild(overlay);
          document.body.style.overflow = 'hidden';

          overlay.querySelector('button')?.addEventListener('click', close);
          overlay.addEventListener('click', (e) => {
            if (e.target === overlay) close();
          });
          const esc = (e) => {
            if (e.key === 'Escape') {
              close();
              document.removeEventListener('keydown', esc);
            }
          };
          document.addEventListener('keydown', esc);

          overlay.querySelectorAll('a').forEach((a) => {
            a.addEventListener('click', () => {
              const href = a.getAttribute('href') || '';
              close();
              if (href.startsWith('/#') || href === location.pathname) {
                setTimeout(() => {
                  const target = document.querySelector(href.slice(1) || 'body');
                  target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 80);
              }
            });
          });
        });
      }
    </script>
  </body>
</html>
