---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/StructuredData.astro';

const title = 'Domain Insights | VidaEnLaPlaya.com';
const description =
  'Practical guides on premium domain valuation, coastal and lifestyle brand strategy, and secure escrow acquisition — from the team behind VidaEnLaPlaya.com.';

const posts = Object.values(import.meta.glob('./*.md', { eager: true }) as Record<string, any>)
  .map((p) => ({
    href: p.url as string,
    title: p.frontmatter.title as string,
    description: p.frontmatter.description as string,
    category: (p.frontmatter.category as string) ?? 'Insights',
    pubDate: new Date(p.frontmatter.pubDate as string),
  }))
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime());

const siteUrl = 'https://vidaenlaplaya.com';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: 'Domain Insights',
      url: `${siteUrl}/insights/`,
      description,
      inLanguage: 'en-US',
      isPartOf: { '@id': `${siteUrl}/#website` },
    },
    {
      '@type': 'ItemList',
      itemListElement: posts.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: p.title,
        url: new URL(p.href, siteUrl).href,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'VidaEnLaPlaya.com', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Insights', item: `${siteUrl}/insights/` },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <StructuredData slot="head" schema={schema} />

  <section class="py-14 sm:py-20 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto">
      <nav aria-label="Breadcrumb" class="text-sm text-ocean-600 dark:text-ocean-300 mb-8">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ocean-900 dark:hover:text-white py-2 inline-block">VidaEnLaPlaya.com</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-ocean-900 dark:text-white">Insights</li>
        </ol>
      </nav>

      <div class="accent-line mb-8 reveal"></div>
      <h1 class="section-title mb-4 reveal">Domain Insights</h1>
      <p class="text-lg text-ocean-600 dark:text-ocean-300 max-w-2xl mb-12 reveal">
        Valuation frameworks, market context, and secure buying processes &mdash; written for founders, brand
        strategists, and investors evaluating VidaEnLaPlaya.com.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {posts.map((p, i) => (
          <a
            href={p.href}
            data-track={`insights-index-${i + 1}`}
            class="glass rounded-2xl p-6 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-ocean-900/10 reveal"
          >
            <span class="pill self-start mb-4">{p.category.toUpperCase()}</span>
            <h2 class="font-serif text-xl font-semibold text-ocean-900 dark:text-white mb-2 leading-snug">{p.title}</h2>
            <p class="text-sm text-ocean-700 dark:text-ocean-300 leading-relaxed flex-1">{p.description}</p>
            <span class="mt-5 text-xs text-ocean-600 dark:text-ocean-300">
              <time datetime={p.pubDate.toISOString().slice(0, 10)}>
                {p.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </span>
          </a>
        ))}
      </div>

      <div class="mt-14 rounded-3xl border border-ocean-200 dark:border-ocean-800 p-6 sm:p-8 text-center bg-ocean-50/60 dark:bg-abyss-900 reveal">
        <h2 class="font-serif text-2xl font-bold text-ocean-900 dark:text-white mb-2">
          Looking at VidaEnLaPlaya.com?
        </h2>
        <p class="text-ocean-600 dark:text-ocean-300 mb-5 text-base">
          Asking $75,000 USD &mdash; serious offers considered, secure escrow transfer, response within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/#offer" data-track="insights-make-offer" class="cta-accent px-6 py-3 text-base">Make an Offer</a>
          <a
            href="mailto:sales@desertrich.com?subject=Acquisition%20Inquiry%20-%20VidaEnLaPlaya.com"
            data-track="insights-inquire"
            class="cta-secondary px-6 py-3 text-base"
          >
            Contact Agent
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
