---
const offerMailto =
  'mailto:sales@desertrich.com?subject=Offer%20for%20VidaEnLaPlaya.com%20%E2%80%94%20%5BYour%20Offer%5D&body=Hi%2C%0A%0AI%27d%20like%20to%20make%20an%20offer%20for%20VidaEnLaPlaya.com.%0A%0AOffer%20amount%20(USD)%3A%20%0AIntended%20use%3A%20%0AName%3A%20%0A%0AThank%20you!';
const buyNowMailto =
  'mailto:sales@desertrich.com?subject=Buy%20Now%20%E2%80%94%20VidaEnLaPlaya.com%20via%20Escrow&body=Hi%2C%0A%0AI%27d%20like%20to%20proceed%20with%20a%20secure%20Escrow.com%20transaction%20for%20VidaEnLaPlaya.com.%20Please%20send%20next%20steps.%0A%0AName%3A%20%0A';
const agentMailto =
  'mailto:sales@desertrich.com?subject=Questions%20about%20VidaEnLaPlaya.com&body=Hi%2C%0A%0AI%20have%20a%20question%20about%20VidaEnLaPlaya.com%3A%20%0A%0AName%3A%20%0A';
---

<section id="top" class="relative w-full overflow-hidden ocean-gradient pt-6 sm:pt-10">
  <!-- Decorative background elements -->
  <div class="absolute inset-0 opacity-[0.03] bg-[radial-gradient(circle_at_30%_40%,#3c91a8_0.5px,transparent_0.5px)] bg-[length:24px_24px]"></div>

  <div class="relative z-10 w-full min-w-0 max-w-6xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-16 sm:pb-24 text-center">
    <!-- Status badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 border border-ocean-200 text-ocean-700 text-sm font-medium mb-8 dark:bg-abyss-900/80 dark:border-ocean-800 dark:text-ocean-300">
      <span class="w-2 h-2 rounded-full bg-ocean-500 animate-pulse"></span>
      One-of-one asset &mdash; premium domain available for acquisition
    </div>

    <!-- Domain browser mockup -->
    <div class="mb-10 w-full min-w-0 max-w-3xl mx-auto">
      <div class="rounded-2xl overflow-hidden shadow-2xl shadow-ocean-900/15 border border-ocean-200/70 bg-white dark:border-ocean-900 dark:bg-abyss-900">
        <div class="flex items-center gap-2 px-4 py-2.5 bg-ocean-50 border-b border-ocean-100 dark:bg-abyss-800 dark:border-ocean-900">
          <span class="w-2.5 h-2.5 rounded-full bg-sand-400/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-ocean-300/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-ocean-200/80"></span>
          <span class="ml-3 flex-1 truncate text-left text-xs font-mono text-ocean-600 bg-white rounded-md px-3 py-1 border border-ocean-100 dark:text-ocean-300 dark:bg-abyss-900 dark:border-ocean-800">
            https://vidaenlaplaya.com
          </span>
          <svg class="w-3.5 h-3.5 text-ocean-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <img
          src="/media/hero-768.webp"
          srcset="/media/hero-480.webp 480w, /media/hero-768.webp 768w, /media/hero-1200.webp 1200w"
          sizes="(max-width: 1024px) calc(100vw - 40px), 768px"
          alt="VidaEnLaPlaya.com — beach life, coastal luxury, paradise living domain preview"
          class="w-full h-auto"
          width="1200"
          height="655"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <!-- Main headline: domain name is the H1 -->
    <h1 class="font-serif text-[2.25rem] leading-[1.05] sm:text-5xl lg:text-7xl font-bold text-ocean-900 dark:text-white mb-5 break-words">
      <span class="block sm:inline">VidaEnLaPlaya</span><span class="text-ocean-600 dark:text-ocean-400 block sm:inline">.com</span>
    </h1>

    <p class="text-xl sm:text-2xl text-ocean-700 dark:text-ocean-200 font-light max-w-2xl mx-auto leading-relaxed mb-4">
      The rare, globally resonant domain that owns &ldquo;Beach Life&rdquo;
    </p>

    <p class="text-base sm:text-lg text-ocean-600 dark:text-ocean-300 max-w-xl mx-auto leading-relaxed">
      Two simple Spanish words. One unforgettable .com &mdash; an authentic expression of paradise, leisure, and the good life.
    </p>

    <!-- Price + availability -->
    <div class="mt-8 inline-flex flex-col items-center gap-1 px-6 py-4 rounded-2xl bg-white/80 border border-ocean-200 dark:bg-abyss-900/80 dark:border-ocean-800">
      <span class="text-xs font-semibold tracking-[2px] text-ocean-600 dark:text-ocean-400">ASKING PRICE</span>
      <span class="font-serif text-3xl sm:text-4xl font-bold text-ocean-900 dark:text-white">$75,000 <span class="text-lg font-sans font-semibold text-ocean-600 dark:text-ocean-300">USD</span></span>
      <span class="text-sm text-ocean-600 dark:text-ocean-300">Serious offers considered &bull; Secure escrow transfer</span>
    </div>

    <!-- Tiered CTAs -->
    <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 max-w-3xl mx-auto">
      <a href="#offer" data-track="hero-make-offer" class="cta-accent px-7 py-4 text-base sm:text-lg">
        Make an Offer
      </a>
      <a href={buyNowMailto} data-track="hero-buy-now" class="cta-primary px-7 py-4 text-base sm:text-lg">
        Buy Now via Escrow
      </a>
      <a href={agentMailto} data-track="hero-contact-agent" class="cta-secondary px-7 py-4 text-base sm:text-lg">
        Contact Agent
      </a>
    </div>

    <!-- Trust signals -->
    <div class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-sm text-ocean-600 dark:text-ocean-300">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        Escrow.com protected
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        SSL secured transfer
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        Response within 24 hours
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        <span id="viewer-count">Investors and brand buyers are reviewing this domain</span>
      </span>
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent dark:from-abyss-950 pointer-events-none"></div>
</section>
